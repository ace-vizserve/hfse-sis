# Supabase — shared project hosting both admissions tables (ay{YYYY}_enrolment_*)
# and the grading schema (academic_years, students, grading_sheets, ...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, never expose to the browser.
# Used for the admissions roster read and all privileged API routes.
SUPABASE_SERVICE_KEY=

# PDF service URL — reserved, currently unused.
# The Python/WeasyPrint service from the original plan is deferred; the report
# card preview page uses the browser's Print / Save as PDF dialog instead.
# See Sprint 6 decision note in docs/sprints/development-plan.md.
PDF_SERVICE_URL=

# Parent portal URL — where the SIS sends parents back to if the
# handoff at /parent/enter fails (missing/expired tokens, setSession error).
# Should point at the authenticated parent-portal dashboard so returning
# parents land logged-in, not at a sign-in screen.
#
# Per-environment values (set these in Vercel → Settings → Environment
# Variables, one per environment — do NOT hardcode one here and ship it
# to production):
#
#   Production : https://enrol.hfse.edu.sg/admission/dashboard
#   Preview    : https://online-admission-staging.vercel.app/admission/dashboard
#   Development: https://online-admission-staging.vercel.app/admission/dashboard
#
# The value below is for local dev only. See docs/context/10-parent-portal.md
# § "Parent portal → SIS handoff" for the full per-environment setup.
NEXT_PUBLIC_PARENT_PORTAL_URL=https://online-admission-staging.vercel.app/admission/dashboard

# Admissions portal ORIGIN — server-only. The production origin of the external
# admissions SPA, used by lib/cors.ts to build the CORS allowlist for the
# stateless parent API at /api/parent/v2/*. Origin only, no path.
#
#   Production : https://enrol.hfse.edu.sg
#
# The staging origin (https://online-admission-staging.vercel.app) and local
# http://localhost:5173 are hardcoded in lib/cors.ts, so leaving this unset in
# dev is fine — only those two are permitted. Unset in PRODUCTION means the
# real portal is refused by CORS and parents see an empty report card.
ADMISSIONS_PORTAL_ORIGIN=

# Resend — transactional email for parent report-card publication
# notifications and change-request state transitions. Server-only.
# If unset, the notification helpers silently no-op so local dev works
# without the dep (see lib/notifications/email-parents-publication.ts
# and lib/notifications/email-change-request.ts). In non-production
# (NODE_ENV !== 'production') every email is redirected to a static
# dev address regardless of recipient.
RESEND_API_KEY=

# Optional. Defaults to "HFSE SIS <noreply@hfse.edu.sg>" when unset.
# Must be a verified sender on the Resend account.
RESEND_FROM_EMAIL=

# DEAD — do not provision or rotate. The in-SIS parent_session cookie SSO
# surface this signed (KD #65/#73) was removed; no live code reads this var.
# Kept only so an older .env.local doesn't look like it's missing something.
PARENT_HANDOFF_SECRET=

# SIS application URL — absolute origin used to build email CTAs that
# deep-link recipients to specific SIS pages (e.g. change-request emails
# include Approve / Reject buttons that point at /markbook/change-requests).
# Email clients can't resolve relative paths, so we need the full origin.
#
# Per-environment values (set in Vercel → Settings → Environment Variables,
# one per environment — do NOT hardcode one here and ship it to production):
#
#   Production : https://sis.hfse.edu.sg
#   Preview    : <your Vercel preview URL — verify in Project → Settings → Domains>
#   Development: http://localhost:3000
#
# Best-effort: when unset, change-request emails still send but the CTA
# buttons fall back to relative URLs and won't navigate from most email
# clients (a console.warn is emitted at render time). Unlike
# RESEND_API_KEY — which suppresses the send entirely when unset — this
# var only degrades the CTAs; emails are still delivered. The value below
# is for local dev only.
NEXT_PUBLIC_SIS_URL=http://localhost:3000

# HMAC secret for the one-click approve/reject action tokens in change-request
# emails. Each approver's Approve / Reject button carries a signed token so the
# quick-action page can act on their behalf without a login. Server-only;
# generate with `openssl rand -hex 32` (≥32 chars). MUST differ per
# environment; rotating it invalidates any outstanding quick-action links
# (recipients fall back to logging in). Best-effort: when unset, the email
# buttons fall back to the in-app deep-link (a console.warn is emitted at
# import time) — emails still send.
CHANGE_REQUEST_ACTION_SECRET=

# Cron secret — server-only. Vercel sends this as `Authorization: Bearer <value>`
# when it invokes a scheduled job, and the routes below verify it before doing
# anything. Set it in Vercel → Settings → Environment Variables; it is NOT
# needed for local dev unless you're calling these by hand.
#
# Verified by:
#   POST /api/grading-sheets/lock-overdue   (auto-lock overdue sheets)
#   POST /api/sis/students/auto-sync        (nightly student sync)
#
# Unset in production means those endpoints reject every call, so the jobs
# silently stop running.
CRON_SECRET=
