# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real values stay local; example templates are committed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.fallow/

# brainstorm mockups (superpowers)
.superpowers/

/reports/fallow/

/AY 2025*


# HFSE reference workbooks — Excel files dropped at the repo root for
# canonical-spec verification (report books, attendance workbooks,
# evaluation checklists, etc.). Stay local; never committed.

*.xls
*.xlsm

# HFSE reference data exports (real student PII — admissions metadata,
# reconciliation worklists). Root-level only; stay local, never committed.
/AY*.csv
/*Metada*.csv

# Claude Code — local-only + agent tooling artifacts (dev-only, never used in
# prod). Project config under .claude/rules/ and .claude/commands/ stays tracked.
.claude/settings.local.json
.claude/worktrees/
.claude/plans/

/presentations
# AY2025 backfill artifacts (PII — never commit)
ay2025_fca_writeups.sql
ay2025_calendar.sql

# Untracked student-data spreadsheets at repo root (PII — never commit)
/*.xlsx

# AY2026 source Excel data (real student PII — attendance/grading/evaluation
# workbooks). Local input for scripts/backfill/gen-ay2026-*.ts; never commit.
/AY2026/

# AY2026 enrollment import output (real student PII — names, student
# numbers, enrolee numbers). Generated by gen-ay2026-t1-enrollment.ts;
# review locally, never commit.
scripts/backfill/ay2026-t1-enrollment-*.sql

# AY2026 attendance import output (real student PII — attendance marks
# keyed by section_student_id). Generated by gen-ay2026-t1-attendance.ts;
# apply is split into multiple chunked files under apply/ since the
# combined query is too large for the Supabase SQL Editor. Review locally,
# never commit.
scripts/backfill/ay2026-t1-attendance-preview.sql
scripts/backfill/ay2026-t1-attendance-apply/

# AY2026 grading import output (real student PII — names, scores).
# Generated by gen-ay2026-t1-grading.ts; review locally, never commit.
scripts/backfill/ay2026-t1-grading-*.sql

# AY2026 Primary subject_configs backfill output (template-sourced config,
# not student PII, but kept out of the repo like every other generated
# backfill artifact). Generated by gen-ay2026-primary-subject-configs.ts.
scripts/backfill/ay2026-primary-subject-configs-*.sql

# AY2026 remaining sections/subjects attachment output. Generated by
# gen-ay2026-remaining-sections-subjects.ts.
scripts/backfill/ay2026-remaining-sections-subjects-*.sql

# AY2026 T2 attendance import output (real student PII — attendance marks
# keyed by section_student_id). Generated by gen-ay2026-t2-attendance.ts;
# apply is split into multiple chunked files under apply/ since the
# combined query is too large for the Supabase SQL Editor. Review locally,
# never commit.
scripts/backfill/ay2026-t2-attendance-preview.sql
scripts/backfill/ay2026-t2-attendance-apply/
